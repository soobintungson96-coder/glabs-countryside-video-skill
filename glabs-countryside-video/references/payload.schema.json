{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:claude-skill:glabs-countryside-video:3.4",
  "title": "Canonical countryside episode production plan (not G-Labs API payload)",
  "type": "object",
  "required": [
    "schema_version",
    "original_title",
    "preflight_configuration",
    "production",
    "characters",
    "shots",
    "audio_policy",
    "thumbnail",
    "seo",
    "deliverables",
    "approvals",
    "provider"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.4"
    },
    "original_title": {
      "type": "string",
      "minLength": 1
    },
    "preflight_configuration": {
      "type": "object",
      "properties": {
        "target_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "character_choice": {
          "enum": [
            "user_specified",
            "none",
            "claude_proposes"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "quality_choice": {
          "enum": [
            "FULL_HD",
            "4K_UHD"
          ]
        },
        "output_folder": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target_duration_seconds",
        "character_choice",
        "location",
        "model_id",
        "quality_choice",
        "output_folder"
      ],
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1
        },
        "resolution": {
          "enum": [
            "1920x1080",
            "3840x2160"
          ]
        },
        "aspect_ratio": {
          "const": "16:9"
        },
        "cut_style": {
          "const": "hard_cut"
        },
        "watermark_enabled": {
          "const": false
        },
        "subtitles_enabled": {
          "const": false
        }
      },
      "required": [
        "fps",
        "total_frames",
        "resolution",
        "aspect_ratio",
        "cut_style",
        "watermark_enabled",
        "subtitles_enabled"
      ],
      "additionalProperties": false
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "appearance_lock": {
            "type": "string",
            "minLength": 1
          },
          "reference_image_prompt": {
            "type": "string",
            "minLength": 1
          },
          "asset_uri": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "role",
          "appearance_lock",
          "reference_image_prompt",
          "asset_uri"
        ],
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "scene_type": {
            "enum": [
              "MAIN",
              "BROLL"
            ]
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "continuity_before": {
            "type": "string",
            "minLength": 1
          },
          "continuity_after": {
            "type": "string",
            "minLength": 1
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shot_size": {
            "enum": [
              "WIDE",
              "MEDIUM",
              "CLOSE",
              "MACRO"
            ]
          },
          "camera_motion": {
            "type": "string",
            "minLength": 1
          },
          "image_prompt": {
            "type": "string",
            "minLength": 1
          },
          "video_prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_prompt": {
            "type": "string",
            "minLength": 1
          },
          "audio_prompt": {
            "type": "string",
            "minLength": 1
          },
          "qc_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "order",
          "scene_type",
          "duration_frames",
          "purpose",
          "continuity_before",
          "continuity_after",
          "subjects",
          "reference_ids",
          "shot_size",
          "camera_motion",
          "image_prompt",
          "video_prompt",
          "negative_prompt",
          "audio_prompt",
          "qc_risks"
        ],
        "additionalProperties": false
      }
    },
    "audio_policy": {
      "type": "object",
      "properties": {
        "dialogue_enabled": {
          "const": false
        },
        "voiceover_enabled": {
          "const": false
        },
        "singing_lyrics_enabled": {
          "const": false
        },
        "speech_in_background_enabled": {
          "const": false
        },
        "ambient_asmr_enabled": {
          "const": true
        },
        "instrumental_music_only": {
          "const": true
        },
        "music_license_required": {
          "const": true
        }
      },
      "required": [
        "dialogue_enabled",
        "voiceover_enabled",
        "singing_lyrics_enabled",
        "speech_in_background_enabled",
        "ambient_asmr_enabled",
        "instrumental_music_only",
        "music_license_required"
      ],
      "additionalProperties": false
    },
    "thumbnail": {
      "type": "object",
      "properties": {
        "image_prompt": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "text_overlay_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "image_prompt",
        "width",
        "height",
        "text_overlay_enabled"
      ],
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "properties": {
        "title_en": {
          "type": "string",
          "minLength": 1
        },
        "alternative_title_en": {
          "type": "string",
          "minLength": 1
        },
        "description_en": {
          "type": "string",
          "minLength": 1
        },
        "tags_en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hashtags_en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title_en",
        "description_en",
        "tags_en",
        "hashtags_en"
      ],
      "additionalProperties": false
    },
    "deliverables": {
      "type": "object",
      "properties": {
        "video": {
          "type": "string",
          "minLength": 1
        },
        "thumbnail": {
          "type": "string",
          "minLength": 1
        },
        "seo": {
          "type": "string",
          "minLength": 1
        },
        "storyboard": {
          "type": "string",
          "minLength": 1
        },
        "job_manifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "video",
        "thumbnail",
        "seo",
        "storyboard",
        "job_manifest"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "properties": {
        "configuration_approved": {
          "type": "boolean"
        },
        "storyboard_approved": {
          "type": "boolean"
        },
        "execution_approved": {
          "type": "boolean"
        }
      },
      "required": [
        "configuration_approved",
        "storyboard_approved",
        "execution_approved"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "glabs_studio"
        },
        "adapter_status": {
          "enum": [
            "UNVERIFIED",
            "READY",
            "UNSUPPORTED"
          ]
        },
        "render_kind": {
          "enum": [
            "UNCONFIRMED",
            "FULL_HD",
            "NATIVE_4K",
            "UPSCALED_4K"
          ]
        }
      },
      "required": [
        "provider",
        "adapter_status",
        "render_kind"
      ],
      "additionalProperties": false
    },
    "history_reference": {
      "type": "string"
    }
  }
}
